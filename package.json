{
  "name": "@68publishers/cookie-consent",
  "version": "1.6.0",
  "description": "Cookie consent wrapper based on orestbida/cookieconsent with GTM integration.",
  "homepage": "http://www.68publishers.io/",
  "main": "index.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/68publishers/cookie-consent"
  },
  "scripts": {
    "build:dev": "webpack --config webpack.config.dev.mjs --progress --profile",
    "build:prod": "webpack --config webpack.config.prod.mjs --progress --profile",
    "start:dev": "webpack --config webpack.config.dev.mjs --progress --profile && webpack-dev-server --config webpack.config.dev.mjs",
    "eslint:fix": "eslint ./index.mjs ./src --fix",
    "eslint": "eslint ./index.mjs ./src",
    "build:test": "CC_OUT_DIR=var/build webpack --config webpack.config.prod.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run build:test && npm run ref && npm run test:unit && npm run test:e2e",
    "demo": "npm run build:test && node tests/server.mjs",
    "perf": "npm run build:test && node perf/run.mjs",
    "perf:baseline": "node perf/run.mjs --ref --baseline",
    "test:a11y-baseline": "A11Y_REPORT=perf/a11y-baseline-1.6.0.json CC_TARGET=dist playwright test tests/e2e/a11y.spec.mjs --project=chromium",
    "ref": "node perf/download-ref.mjs",
    "size": "npm run build:test && size-limit",
    "test:visual": "playwright test --project=visual",
    "test:visual:gallery": "node tests/visual/gallery.mjs"
  },
  "keywords": [
    "68publishers",
    "consent",
    "cookieconsent",
    "cookie-consent"
  ],
  "author": "68publishers",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.16.0",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.16.4",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.5.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.3.0",
    "babel-loader": "^8.2.3",
    "copy-webpack-plugin": "^12.0.2",
    "core-js": "^3.39.0",
    "crypto-js": "^4.2.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.6",
    "eslint": "^9.5.0",
    "globals": "^15.6.0",
    "jsdom": "^30.1.3",
    "json-minimizer-webpack-plugin": "^5.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.4.49",
    "postcss-custom-properties": "^14.0.4",
    "postcss-loader": "^8.1.1",
    "size-limit": "^14.3.0",
    "string-replace-loader": "^3.1.0",
    "terser-webpack-plugin": "^5.2.5",
    "vitest": "^5.0.5",
    "webpack": "^5.65.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.6.0"
  },
  "dependencies": {
    "vanilla-cookieconsent": "github:orestbida/cookieconsent#v3.2.0"
  },
  "files": [
    "src",
    "index.mjs",
    "dist/cookie-consent.min.js",
    "dist/cookie-consent.css",
    "dist/translations/*"
  ]
}
